name: Build calculator install files
on:
  push:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4
      - name: Install official CE C++ toolchain
        run: |
          curl --fail --location --retry 3 https://github.com/CE-Programming/toolchain/releases/download/v11.2/CEdev-Linux.tar.gz -o "$RUNNER_TEMP/cedev.tar.gz"
          tar -xzf "$RUNNER_TEMP/cedev.tar.gz" -C "$RUNNER_TEMP"
          echo "$RUNNER_TEMP/CEdev/bin" >> "$GITHUB_PATH"
      - name: Build graphics and game
        run: |
          make gfx
          make
      - name: Package install files
        run: |
          mkdir -p install
          cp bin/CELESTE.8xp install/
          cp INSTALL.txt install/
          cp LICENSE install/LICENSE.txt
          curl --fail --location --retry 3 https://github.com/CE-Programming/libraries/releases/download/v15.0/clibs.8xg -o install/clibs.8xg
      - uses: actions/upload-artifact@v4
        with:
          name: CEleste-timer-reset
          path: install/
          if-no-files-found: error
